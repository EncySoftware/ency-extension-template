<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <OutDir>bin\$(Configuration)\</OutDir>
  </PropertyGroup>

  <!-- keep the Release output flat and clean: it is packed into the store package as-is -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <!-- ENCY 3. The version is EXACT (square brackets), not "at least", and must not be raised
         casually. The SDK fixes the versions of the CAMAPI/CADAPI *.DotnetHelper assemblies; ENCY
         ships its own copies of those and .NET never loads one older than requested. So an
         extension built against an SDK newer than the installed ENCY does not load at all, and the
         manager only says "Could not create instance of CAMAPI.ExtensionFactory", which names
         nothing. Raise this only after that SDK has shipped in a released ENCY: 3.0.8 pulls
         DotnetHelper 3.0.6, which is what ENCY 3.0.7 carries, while 3.0.9 pulls 3.0.7, which no
         released ENCY has. The framework follows the application: ENCY 3 runs on .NET 10, and an
         extension is a library loaded into that process. Both trades are one-way - an older SDK
         and an older framework load in a newer ENCY, never the reverse. -->
    <!-- Pinned BELOW what the store recommends, on purpose, and temporarily. An extension is
         registered inside the store tab's own process, and the tab carries its own copies of the
         CAMAPI assemblies - older than the ones ENCY ships. Built against 3.0.8 the extension calls
         members those copies do not have, and registration fails with "Could not create instance of
         CAMAPI.ExtensionFactory" on both the released and the nightly application (measured
         04.09.2026 on EncyPulse 0.1.0 and a fresh EncyTest). Under 3.0.6 the requirements match
         EncyToolsCatalog 0.1.23, which installs and runs on the released ENCY 3.0.7 today.
         Raise this to what GET /api/sdk answers once a released ENCY carries the tab fix. -->
    <PackageReference Include="EncySoftware.CAMAPI.Sdk.Net" Version="[3.0.6]" />
  </ItemGroup>

  <ItemGroup>
    <None Update="EncyExtension.settings.json" CopyToOutputDirectory="Always" />
    <None Update="package.info.json" CopyToOutputDirectory="Always" />
    <None Update="readme.md" CopyToOutputDirectory="Always" />
    <!-- Pictures of the extension: the store turns them into the card's screenshots and takes the
         first one as its cover. Two details matter. Only image extensions are copied, so the note in
         that folder does not end up in the package (and cannot shadow readme.md). And Link flattens
         them into the output root, because CI uploads only the top level of the build output. -->
    <None Include="screenshots\*.png;screenshots\*.jpg;screenshots\*.jpeg;screenshots\*.gif;screenshots\*.webp"
          CopyToOutputDirectory="Always" Link="%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- The SDK's transitive packages copy ~60 doc xmls into the output via their own
       AfterTargets="Build" hooks, which run after any hook declared here. PackReady therefore
       DEPENDS on Build: its body executes only after Build and all its hooks are done.
       Build with `dotnet build src -c Release -t:PackReady` to get an output folder that is
       clean to pack into the store package as-is. -->
  <Target Name="PackReady" DependsOnTargets="Build">
    <ItemGroup>
      <_SdkJunk Include="$(OutDir)*.xml" Exclude="$(OutDir)$(AssemblyName).xml" />
      <_SdkJunk Include="$(OutDir)*.stbuildresult.json" />
    </ItemGroup>
    <Delete Files="@(_SdkJunk)" />
    <Message Importance="high" Text="PackReady: output cleaned for packing -> $(OutDir)" />
  </Target>
</Project>
